# ============================================================
# Tools4Genz — Frontend Environment Configuration
# ============================================================
#
# These variables are public (safe to commit). They control the
# Cloudflare Worker API base URL that the frontend uses for
# request submission, admin APIs, and checkout/payment verification.
#
# -----------------------------------------------------------------
# VITE_API_BASE_URL
#   Development against local worker:
#     VITE_API_BASE_URL=http://localhost:8787
#
#   Development against deployed worker:
#     VITE_API_BASE_URL=https://tools4genz-api.alokmodanwal940.workers.dev
#
#   Production custom domain:
#     VITE_API_BASE_URL=https://api.tools4genz.com
#
# -----------------------------------------------------------------
VITE_API_BASE_URL=https://tools4genz-api.alokmodanwal940.workers.dev

# Canonical origin for the deployment. Keep pages.dev until the custom domain
# resolves, then set this to https://tools4genz.com in Cloudflare Pages.
VITE_SITE_ORIGIN=https://tools4genz.pages.dev
